{
  "appId": "ch.easyplay.app",
  "appName": "easyplay",
  "webDir": "www",
  "server": {
    "url": "https://djsunji.github.io/easyplay/",
    "cleartext": false,
    "allowNavigation": ["djsunji.github.io"]
  },
  "ios": {
    "contentInset": "never",
    "limitsNavigationsToAppBoundDomains": true,
    "backgroundColor": "#2B1466"
  },
  "android": {
    "backgroundColor": "#2B1466"
  },
  "plugins": {
    "SplashScreen": { "launchShowDuration": 1200, "backgroundColor": "#2B1466", "showSpinner": false, "launchAutoHide": true },
    "StatusBar": { "style": "DARK", "backgroundColor": "#2B1466", "overlaysWebView": false }
  }
}
