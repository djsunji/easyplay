{
 "appId": "ch.easyplay.app",
 "appName": "easyplay",
 "webDir": "www",
 "ios": {
  "contentInset": "never",
  "backgroundColor": "#2B1466"
 },
 "android": {
  "backgroundColor": "#2B1466"
 },
 "plugins": {
  "SplashScreen": {
   "launchShowDuration": 800,
   "backgroundColor": "#2B1466",
   "showSpinner": false,
   "launchAutoHide": true
  },
  "StatusBar": {
   "style": "DARK",
   "backgroundColor": "#2B1466",
   "overlaysWebView": false
  },
  "LocalNotifications": {
   "iconColor": "#2B1466"
  }
 }
}
